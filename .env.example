# Generate API_TOKEN with: openssl rand -hex 32
API_TOKEN=replace-with-a-long-random-secret

# Copy the tunnel token from the Cloudflare Zero Trust dashboard.
CF_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# Hosts the Go API may connect to for connection-string import
# (comma separated, host or host:port). Leave empty to disable the feature.
ALLOWED_DB_HOSTS=
# Set to 1 only if a database cannot use TLS.
DB_ALLOW_INSECURE=0
# SQL Server with a self-signed certificate: set to 1 (still encrypted, cert not verified).
DB_TRUST_SERVER_CERT=0

# --- Vercel / Next.js app login (set these in Vercel, not on the connector) ---
# APP_PASSWORD=choose-a-long-passphrase
# SESSION_SECRET=generate with: openssl rand -hex 32
